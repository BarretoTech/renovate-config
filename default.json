{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate configuration for every repository in the Barreto Tech enterprise: the archgate, jack-for-work and BarretoTech organizations.",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    ":automergeRequireAllStatusChecks",
    ":approveMajorUpdates",
    ":rebaseStalePrs",
    ":enableVulnerabilityAlerts",
    ":timezone(Europe/Oslo)",
    ":gitSignOff"
  ],
  "schedule": [
    "* 0-5 25-31 * 0"
  ],
  "automergeSchedule": [
    "* 0-5 25-31 * 0"
  ],
  "semanticCommits": "enabled",
  "osvVulnerabilityAlerts": true,
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "configMigration": true,
  "reviewersFromCodeOwners": true,
  "labels": ["dependencies"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.archgate/fixtures/**"
  ],
  "nuget": {
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__fixtures__/**",
      "**/.archgate/fixtures/**"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Archgate CLI version pinned in .archgate/version",
      "managerFilePatterns": ["/^\\.archgate/version$/"],
      "matchStrings": ["^\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "archgate/cli",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Zizmor version pinned in .prototools",
      "managerFilePatterns": ["/^\\.prototools$/"],
      "matchStrings": ["(?m)^zizmor\\s*=\\s*\"(?<currentValue>\\d[^\"]*)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "zizmorcore/zizmor",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Stripe CLI version pinned in .prototools",
      "managerFilePatterns": ["/^\\.prototools$/"],
      "matchStrings": ["(?m)^stripe\\s*=\\s*\"(?<currentValue>\\d[^\"]*)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "stripe/stripe-cli",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Archgate CLI version pinned in .prototools",
      "managerFilePatterns": ["/^\\.prototools$/"],
      "matchStrings": ["(?m)^archgate\\s*=\\s*\"(?<currentValue>\\d[^\"]*)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "archgate/cli",
      "packageNameTemplate": "archgate/cli",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Archgate Proto plugin release pinned in .prototools",
      "managerFilePatterns": ["/^\\.prototools$/"],
      "matchStrings": [
        "(?m)^archgate\\s*=\\s*\"github://archgate/proto-plugin@(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "archgate/proto-plugin"
    },
    {
      "customType": "regex",
      "description": "Moon version pinned by .moon/workspace.yml versionConstraint",
      "managerFilePatterns": ["/^\\.moon/workspace\\.yml$/"],
      "matchStrings": ["(?m)^versionConstraint:\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "moon",
      "packageNameTemplate": "moonrepo/moon",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Proto version pinned by .moon/toolchains.yml proto.version",
      "managerFilePatterns": ["/^\\.moon/toolchains\\.yml$/"],
      "matchStrings": [
        "(?m)^proto:\\s*\\n(?:\\s+#[^\\n]*\\n)*\\s+version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "moonrepo/proto",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Proto version pinned by the moonrepo or BarretoTech setup-toolchain action",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: (?:moonrepo|BarretoTech)/setup-toolchain@\\S+[^\n]*\n\\s+with:\n(?:\\s+[\\w-]+:[^\n]*\n)*?\\s+proto-version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "moonrepo/proto",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group Bun runtime pins in .prototools, package.json and workflows with @types/bun",
      "groupName": "bun",
      "matchPackageNames": ["oven-sh/bun", "@types/bun", "bun"]
    },
    {
      "description": "Group Node.js, npm and GitHub CLI minor and patch updates",
      "groupName": "prototools toolchain",
      "matchPackageNames": ["node", "npm", "cli/cli"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group Archgate CLI pins in .archgate/version and .prototools",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["archgate/cli"],
      "groupName": "archgate"
    },
    {
      "description": "Group Moon pins in .prototools and .moon/workspace.yml",
      "matchManagers": ["proto", "custom.regex"],
      "matchPackageNames": ["moonrepo/moon"],
      "groupName": "moon"
    },
    {
      "description": "Group Proto pins in .prototools, Moon toolchains, setup-toolchain workflows and repo-specific regex managers",
      "matchManagers": ["proto", "custom.regex"],
      "matchPackageNames": ["moonrepo/proto"],
      "groupName": "proto"
    },
    {
      "description": "Group all non-major devDependencies into a single PR per repo",
      "groupName": "devDependencies (non-major)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!@types/bun"]
    },
    {
      "description": "Group all non-major production dependencies into a single PR per repo",
      "groupName": "dependencies (non-major)",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!bun"]
    },
    {
      "description": "Automerge non-major updates for linting, formatting, and type packages",
      "matchPackageNames": [
        "oxlint",
        "oxfmt",
        "prettier",
        "prettier-plugin-astro",
        "eslint",
        "@commitlint/{/,}**",
        "commitizen",
        "/^@types\\//"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Label and require review for major updates",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "automerge": false
    },
    {
      "description": "Label security/vulnerability PRs and bypass the monthly schedule so fixes ship immediately",
      "matchCategories": ["security"],
      "addLabels": ["security"],
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"],
      "prPriority": 10
    },
    {
      "description": "Pin GitHub Actions to SHA digests for supply-chain security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "SLSA reusable workflow MUST stay tag-pinned — generate-builder.sh rejects non-tag refs (slsa-framework/slsa-github-generator#150)",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["slsa-framework/slsa-github-generator"],
      "pinDigests": false
    },
    {
      "description": "Group GitHub Actions updates (excluding bun, which groups with .prototools)",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["!bun"],
      "groupName": "github-actions"
    },
    {
      "description": "Group docs site dependencies (Astro, Starlight, etc.). Commit as chore(deps), not fix(deps): the docs site is not a released artifact, so a bump must not trigger a release.",
      "groupName": "docs dependencies",
      "matchFileNames": ["docs/package.json"],
      "separateMajorMinor": false,
      "semanticCommitType": "chore"
    },
    {
      "description": "Group all Java/Maven dependencies into a single PR",
      "groupName": "java dependencies",
      "matchManagers": ["maven"],
      "separateMajorMinor": false
    },
    {
      "description": "Group all .NET/NuGet dependencies into a single PR",
      "groupName": "dotnet dependencies",
      "matchManagers": ["nuget"],
      "separateMajorMinor": false
    },
    {
      "description": "Group all Python dependencies into a single PR",
      "groupName": "python dependencies",
      "matchManagers": ["pip_requirements", "pip-compile", "pipenv", "poetry", "pep621", "setup-cfg"],
      "separateMajorMinor": false
    },
    {
      "description": "Group all Go module dependencies into a single PR",
      "groupName": "go dependencies",
      "matchManagers": ["gomod"],
      "separateMajorMinor": false
    },
    {
      "description": "Group all Ruby/Bundler dependencies into a single PR",
      "groupName": "ruby dependencies",
      "matchManagers": ["bundler"],
      "separateMajorMinor": false
    }
  ]
}
